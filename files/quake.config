// MESS configuration file for Quake.
// This uses the default configuration, but with a few changes.
// See mess.config for more information.
base-configuration:     mess.config

template-entity-directories:
    {EXE_DIR}\template_entities\mess_core_entities
    {EXE_DIR}\template_entities\trenchbroom
    {EXE_DIR}\template_entities\quake
    {EXE_DIR}\template_entities\custom